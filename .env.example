# ==========================================
# Discord OAuth2 Configuration
# Get these from https://discord.com/developers/applications
# ==========================================
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# ==========================================
# Database Configuration (MongoDB)
# Local MongoDB: "mongodb://localhost:27017/discord_dashboard"
# MongoDB Atlas: "mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/discord_dashboard?retryWrites=true&w=majority"
# ==========================================
DATABASE_URL="mongodb://localhost:27017/discord_dashboard"

# ==========================================
# Application Security Keys
# SECRET_KEY: Used for signing JWT dashboard session cookies
# ENCRYPTION_KEY: 32-byte hex string (64 chars) for AES-256-GCM token encryption
# ==========================================
SECRET_KEY=replace_with_a_secure_jwt_secret_key_at_least_32_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==========================================
# App Base URL
# ==========================================
APP_URL=http://localhost:3000

# Background sync interval in minutes (default: 30)
SYNC_INTERVAL_MINUTES=30
